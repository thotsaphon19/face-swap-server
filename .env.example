APP_ROLE=control-plane
ENABLE_NGINX=true
WORKER_PORT=8000
UVICORN_WORKERS=1
LOG_LEVEL=INFO
# External/public base URL used in session + Flutter client contracts.
PUBLIC_BASE_URL=http://localhost
# Public client token. Use a long random value in production.
SECRET_TOKEN=change-me-public-token
# Internal GPU worker token. Set the same value as SECRET_TOKEN for local testing,
# or use a separate secret when DigitalOcean proxies to Runpod.
RUNPOD_SECRET_TOKEN=change-me-runpod-token
# Leave empty for local CPU-only testing. Set to http://gpu-worker:8000 for the
# local GPU profile, or to your Runpod HTTPS endpoint for DigitalOcean.
RUNPOD_BASE_URL=
MODEL_DIR=/workspace/model/checkpoints
REQUEST_TIMEOUT_SECONDS=60
SESSION_TTL_SECONDS=3600
MAX_IMAGE_BYTES=5242880
# Comma-separated allowed CORS origins (use * to allow all)
CORS_ORIGINS=*

# Flutter mobile app settings (configure in the app Settings screen)
# FLUTTER_SERVER_URL=http://<your-server-ip>:8000
# FLUTTER_API_TOKEN=testing123# Real face-swap model settings (GPU worker)
INSWAPPER_MODEL=inswapper_128.onnx
FACE_ANALYSIS_NAME=buffalo_l
FACE_DET_SIZE=256

OUTPUT_JPEG_QUALITY=72
OPENCV_THREADS=1

# Realtime target tracking (v5)
# Prevents the swap from jumping to another detected face without smoothing
# mouth landmarks, which would create visible speech lag.
TRACK_IOU_THRESHOLD=0.12
TRACK_CENTER_THRESHOLD=0.38
TRACK_MAX_MISSES=3
